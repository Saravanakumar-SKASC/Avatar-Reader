# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; never commit real keys.

# Fish Audio — server-side only (app/api/* route handlers). Never expose to the client.
FISH_AUDIO_API_KEY=
# Local mode: no sign-in; books + progress live in the browser's localStorage.
# Set to false (and fill in the Supabase values below) to use accounts + cloud persistence.
NEXT_PUBLIC_LOCAL_MODE=true

# Supabase — public values, safe for client components.
# The dashboard's Connect dialog shows a "publishable" key (sb_publishable_…); older projects
# show a legacy "anon" JWT. Either works — set whichever name matches what you copied.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role key — server-side only (app/api/* route handlers). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Local binaries (optional; defaults shown). See SETUP.md.
# RHUBARB_PATH=rhubarb
# RHUBARB_RECOGNIZER=phonetic   # or pocketSphinx (slower, slightly more accurate)
# PIPER_PATH=piper
# PIPER_VOICES_DIR=~/piper-voices
